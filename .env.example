# ─── Compose profile — drives the active environment ─────────────────────────
# dev  → builds from source, file watching, port binding
# prod → pulls pre-built image from GHCR, Traefik labels, restart policy
COMPOSE_PROFILES=dev

# ─── App ──────────────────────────────────────────────────────────────────────
APP_PORT=3000
APP_DOMAIN=resume.chrysa.dev

# ─── Docker image (prod only) ─────────────────────────────────────────────────
IMAGE=ghcr.io/chrysa/resume
IMAGE_TAG=latest

# ─── GitHub — target repo for contact Issues ──────────────────────────────────
VITE_GITHUB_OWNER=chrysa
VITE_GITHUB_REPO=contact

# ─── Demo mode ────────────────────────────────────────────────────────────────
# When true, the app serves inline fixture data (e.g. live GitHub repos) and
# shows a persistent amber "DEMO" banner, so it is fully explorable without any
# real credentials or network access. Off by default.
VITE_DEMO_MODE=false

# ─── Optional ─────────────────────────────────────────────────────────────────
# VITE_RATE_LIMIT_MAX=3

# chrysa:opencode-env:start · managed by distribute-standards.sh · DO NOT EDIT
# --- opencode LLM providers ---
OLLAMA_URL=http://127.0.0.1:11434   # local default, offline-first (opencode default model)
ANTHROPIC_API_KEY=                  # opt-in: Claude (cloud)
OPENAI_API_KEY=                     # opt-in: ChatGPT (cloud)
# chrysa:opencode-env:end
